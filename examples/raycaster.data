        struct xdg_toplevel *toplevel)
{
	RGFW_UNUSED(data);
	RGFW_window* win = (RGFW_window*)xdg_toplevel_get_user_data(toplevel);
	if (win == NULL)
		win = RGFW_key_win;

	RGFW_eventQueuePush((RGFW_event){.type = RGFW_quit, ._win = win});
	RGFW_windowQuitCallback(win);
}


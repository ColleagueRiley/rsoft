#ifdef RGFW_IMPLEMENTATION
RGFW_bool RGFW_useWaylandBool = 1;
void RGFW_useWayland(RGFW_bool wayland) { RGFW_useWaylandBool = wayland;  }
RGFW_bool RGFW_usingWayland(void) { return RGFW_useWaylandBool; }

